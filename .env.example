POSTGRES_DB=smart_home
POSTGRES_PORT=5433
POSTGRES_USER=smart_home
POSTGRES_PASSWORD=change-me-for-non-local-use

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:8081,http://localhost:19006
DATABASE_URL=postgresql://smart_home:change-me-for-non-local-use@localhost:5433/smart_home?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ADMIN_USERNAME=backend-admin
MQTT_ADMIN_PASSWORD=replace-with-a-strong-broker-admin-password
MQTT_TOPIC_ROOT=home
MQTT_MAX_PAYLOAD_BYTES=16384
MQTT_CONNECT_TIMEOUT_MS=5000
MQTT_RECONNECT_MIN_MS=1000
MQTT_RECONNECT_MAX_MS=30000
MQTT_MAX_INFLIGHT=16
DEVICE_OFFLINE_AFTER_MS=60000
DEVICE_STATUS_INTERVAL_MS=10000
DB_TRANSACTION_MAX_WAIT_MS=5000
DB_TRANSACTION_TIMEOUT_MS=10000
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_COST=12
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Public mobile values only. Never expose secrets through EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_WS_URL=http://localhost:3000
