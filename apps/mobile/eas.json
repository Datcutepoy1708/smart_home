  "cli": { "version": ">= 16.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://smarthome-production-8fea.up.railway.app/api/v1",
        "EXPO_PUBLIC_REQUEST_TIMEOUT_MS": "10000"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://smarthome-production-8fea.up.railway.app/api/v1",
        "EXPO_PUBLIC_REQUEST_TIMEOUT_MS": "10000"
      }
    }
  },
  "submit": { "production": {} }
}
